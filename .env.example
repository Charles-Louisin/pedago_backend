NODE_ENV=development
PORT=5100
MONGODB_URI=mongodb://127.0.0.1:27017/pedago
# Sans MongoDB local, l'API démarre une base en mémoire (dev uniquement, données perdues à l'arrêt)
MONGO_MEMORY_FALLBACK=true
JWT_SECRET=change-me-pedago-jwt-secret
CORS_ORIGIN=http://localhost:3100
PUBLIC_API_URL=
UPLOADTHING_TOKEN=
OPENROUTER_API_KEY=
AI_MODEL_CLASSIFY=google/gemini-2.5-flash
AI_MODEL_EXTRACT=google/gemini-2.5-flash
AI_MODEL_WRITE=anthropic/claude-sonnet-4.5
AI_MODEL_REVIEW=openai/gpt-5-mini
AI_JOB_DEFAULT_BUDGET_USD=2
AI_WORKER_IN_PROCESS=true
AI_WORKER_CONCURRENCY=2
# Comptes de test créés par le seed (développement)
SEED_ADMIN_EMAIL=admin@pedago.test
SEED_ADMIN_PASSWORD=Pedago-Admin-2026!
SEED_REVIEWER_EMAIL=relecteur@pedago.test
SEED_REVIEWER_PASSWORD=Pedago-Relecteur-2026!
SEED_TEACHER_EMAIL=enseignant@pedago.test
SEED_TEACHER_PASSWORD=Pedago-Enseignant-2026!

# Version du binaire MongoDB en mémoire (dev)
MONGOMS_VERSION=8.2.6
