NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/pedago
# Base utilisée si l'adresse n'en nomme pas (adresse Atlas « …mongodb.net/?… »)
MONGODB_DB=pedago
# Sans MongoDB local, l'API démarre une base en mémoire (dev uniquement, données perdues à l'arrêt)
MONGO_MEMORY_FALLBACK=true
JWT_SECRET=change-me-pedago-jwt-secret
CORS_ORIGIN=http://localhost:3000
PUBLIC_API_URL=
UPLOADTHING_TOKEN=
OPENROUTER_API_KEY=
AI_MODEL_CLASSIFY=google/gemini-2.5-flash
AI_MODEL_EXTRACT=google/gemini-2.5-flash
AI_MODEL_WRITE=anthropic/claude-sonnet-4.5
AI_MODEL_REVIEW=openai/gpt-5-mini
AI_JOB_DEFAULT_BUDGET_USD=2
AI_WORKER_IN_PROCESS=true
AI_WORKER_CONCURRENCY=2
# Comptes de test créés par le seed (développement)
SEED_ADMIN_EMAIL=admin@pedago.test
SEED_ADMIN_PASSWORD=Pedago-Admin-2026!
SEED_TEACHER_EMAIL=enseignant@pedago.test
SEED_TEACHER_PASSWORD=Pedago-Enseignant-2026!

# Version du binaire MongoDB en mémoire (dev)
MONGOMS_VERSION=8.2.6
AI_DAILY_BUDGET_USD=20
AI_MAX_JOBS_PER_BUILD=300
RESEND_API_KEY=
# onboarding@resend.dev n'écrit qu'à l'adresse du titulaire du compte Resend (test) :
# pour écrire à tous les enseignants, vérifier un domaine chez Resend et mettre MAIL_FROM=PEDAGO <noreply@votre-domaine>
MAIL_FROM=PEDAGO <onboarding@resend.dev>
DEV_ECHO_CODES=true

# Double authentification de l'équipe (toujours active en production ; désactivable seulement en dev)
STAFF_MFA_REQUIRED=true

# Sauvegardes (npm run backup / npm run restore)
# BACKUP_KEY : 32 octets en hexadécimal (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Obligatoire en production, à conserver dans un coffre séparé.
BACKUP_KEY=
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
